# Port to run the server on
PORT=5001

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Google Sheets Logging Endpoint (Google Apps Script Web App URL)
# Obtain this by pasting the Apps Script code in Extensions -> Apps Script and clicking Deploy -> New Deployment
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/xxxxxx/exec
